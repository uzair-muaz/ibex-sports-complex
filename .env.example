# =============================================================================
# IBEX Sports Complex — Environment variables
# Copy this file to .env.local and fill in your values. Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ibex-sports-arena
# Production: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ibex-sports-arena

# -----------------------------------------------------------------------------
# App URL (used for emails, links, sitemap)
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-min-32-characters

# Google OAuth (customer login). Create credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google OAuth client IDs for native mobile apps (ID token aud check).
# GOOGLE_SERVER_CLIENT_ID is the Web client the app requests ID tokens for,
# needed only when it differs from GOOGLE_CLIENT_ID above.
# GOOGLE_SERVER_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple: the iPhone app's bundle id (and optional Services id)
# that Apple identity tokens are issued for.
# APPLE_BUNDLE_ID=
# APPLE_SERVICE_ID=

# -----------------------------------------------------------------------------
# HTTP API (/api/v1) — web cookies + mobile Bearer tokens
# -----------------------------------------------------------------------------
# Comma-separated Origins allowed for CORS (mobile webviews / local tooling).
# Use * only for local debugging; prefer explicit origins in production.
API_CORS_ORIGINS=http://localhost:3000

# Mobile JWT lifetime (jose format, e.g. 30d, 7d, 12h). Defaults to 30d.
# API_JWT_EXPIRES_IN=30d

# Optional dedicated signing secret; falls back to NEXTAUTH_SECRET if unset.
# API_JWT_SECRET=

# Mobile refresh token lifetime in days. Defaults to 60.
# API_REFRESH_TOKEN_DAYS=60

# Swagger UI: /docs  |  OpenAPI JSON: /api/v1/openapi

# -----------------------------------------------------------------------------
# Email — Resend (default)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=IBEX Sports <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Email — AWS SES (optional, set EMAIL_PROVIDER=ses)
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your_aws_access_key
# AWS_SECRET_KEY=your_aws_secret_key
# SES_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# SMS — AWS SNS (optional, for booking confirmation SMS)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your_aws_access_key
# AWS_SECRET_KEY=your_aws_secret_key

# -----------------------------------------------------------------------------
# Seed script — Super Admin user (only for initial seed)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@ibex.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# -----------------------------------------------------------------------------
# Public (exposed to browser; optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Error monitoring (optional)
# -----------------------------------------------------------------------------
# Install `@sentry/nextjs` and set DSN to enable captureException in lib/monitoring.ts
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Private file storage for payment screenshots (mobile app).
# "local" = a folder on this server's disk (fine for a normal server / your computer;
# NOT for Vercel, whose disk is wiped). Empty = local on a dev computer, off in production.
FILE_STORAGE=
# Optional folder for FILE_STORAGE=local (default: .uploads in the project, git-ignored)
FILE_STORAGE_DIR=

# --- Notifications (Phase 13) ---
# Push and email are ONLY really sent when these are "true". Keep them off on
# laptops and staging (messages are then just written to the log).
NOTIFY_SEND_PUSH=false
NOTIFY_SEND_EMAIL=false
# Firebase service-account JSON (or the same JSON base64-encoded). Needed for push.
FIREBASE_SERVICE_ACCOUNT=
# Long random string. The reminder job (/api/v1/jobs/reminders) needs
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron sends it automatically.
CRON_SECRET=
