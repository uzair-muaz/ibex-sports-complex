# =============================================================================
# IBEX Sports Complex — Environment variables
# Copy this file to .env.local and fill in your values. Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ibex-sports-arena
# Production: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ibex-sports-arena

# -----------------------------------------------------------------------------
# App URL (used for emails, links, sitemap)
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-min-32-characters

# Google OAuth (customer login). Create credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google OAuth client IDs for native mobile apps (ID token aud check)
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# -----------------------------------------------------------------------------
# HTTP API (/api/v1) — web cookies + mobile Bearer tokens
# -----------------------------------------------------------------------------
# Comma-separated Origins allowed for CORS (mobile webviews / local tooling).
# Use * only for local debugging; prefer explicit origins in production.
API_CORS_ORIGINS=http://localhost:3000

# Mobile JWT lifetime (jose format, e.g. 30d, 7d, 12h). Defaults to 30d.
# API_JWT_EXPIRES_IN=30d

# Optional dedicated signing secret; falls back to NEXTAUTH_SECRET if unset.
# API_JWT_SECRET=

# Swagger UI: /docs  |  OpenAPI JSON: /api/v1/openapi

# -----------------------------------------------------------------------------
# Email — Resend (default)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=IBEX Sports <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Email — AWS SES (optional, set EMAIL_PROVIDER=ses)
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your_aws_access_key
# AWS_SECRET_KEY=your_aws_secret_key
# SES_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# SMS — AWS SNS (optional, for booking confirmation SMS)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=your_aws_access_key
# AWS_SECRET_KEY=your_aws_secret_key

# -----------------------------------------------------------------------------
# Seed script — Super Admin user (only for initial seed)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@ibex.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# -----------------------------------------------------------------------------
# Public (exposed to browser; optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Error monitoring (optional)
# -----------------------------------------------------------------------------
# Install `@sentry/nextjs` and set DSN to enable captureException in lib/monitoring.ts
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
